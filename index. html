    // State Variables
    let currentFactIndex = -1;
    let selectedCategory = 'all';
    let savedFactIds = new Set();
    let isSpeaking = false;
    let speechUtterance = null;

    // Load bookmarks
    try {
      const stored = localStorage.getItem('curio_saved_facts');
      if (stored) {
        savedFactIds = new Set(JSON.parse(stored));
      }
    } catch (e) {
      console.log('LocalStorage unavailable');
    }

    function setCategoryFilter(category, buttonEl) {
      selectedCategory = category;

      // Update button styling
      document.querySelectorAll('.cat-pill').forEach(btn => {
        btn.className = 'cat-pill px-3 py-1.5 rounded-full text-xs font-medium bg-slate-900 text-slate-400 border border-slate-800 hover:text-white transition';
      });
      buttonEl.className = 'cat-pill active px-3 py-1.5 rounded-full text-xs font-semibold bg-blue-600 text-white border border-blue-500 shadow-sm transition';

      const label = document.getElementById('selectedCategoryLabel');
      label.textContent = category === 'all' ? 'Surprise Me (Any)' : category;

      // Haptic simulation
      if (navigator.vibrate) navigator.vibrate(12);
    }

    function generateFactOnDemand() {
      // Filter list based on selected category
      let candidates = FACTS_DATABASE;
      if (selectedCategory !== 'all') {
        candidates = FACTS_DATABASE.filter(f => f.category === selectedCategory);
      }

      if (candidates.length === 0) candidates = FACTS_DATABASE;

      // Pick a random index (avoiding repetition if possible)
      let nextFact;
      if (candidates.length > 1 && currentFactIndex !== -1) {
        const available = candidates.filter(f => f.id !== FACTS_DATABASE[currentFactIndex]?.id);
        nextFact = available[Math.floor(Math.random() * available.length)];
      } else {
        nextFact = candidates[Math.floor(Math.random() * candidates.length)];
      }

      const globalIndex = FACTS_DATABASE.findIndex(f => f.id === nextFact.id);
      renderFact(globalIndex);
      showReaderScreen();

      if (navigator.vibrate) navigator.vibrate(25);
    }

    function nextFact() {
      generateFactOnDemand();
    }

    function showReaderScreen() {
      document.getElementById('homeScreen').classList.add('hidden');
      document.getElementById('factContainer').classList.remove('hidden');
      document.getElementById('readerFooter').classList.remove('hidden');
      document.getElementById('homeNavBtn').classList.remove('hidden');
      document.getElementById('ttsBtn').classList.remove('hidden');
      document.getElementById('bookmarkBtn').classList.remove('hidden');
    }

    function goToHome() {
      stopSpeech();
      document.getElementById('factContainer').classList.add('hidden');
      document.getElementById('readerFooter').classList.add('hidden');
      document.getElementById('homeNavBtn').classList.add('hidden');
      document.getElementById('ttsBtn').classList.add('hidden');
      document.getElementById('bookmarkBtn').classList.add('hidden');
      document.getElementById('homeScreen').classList.remove('hidden');
    }

    function renderFact(index) {
      const fact = FACTS_DATABASE[index];
      if (!fact) return;

      currentFactIndex = index;
      stopSpeech();

      // Meta & Header
      document.getElementById('factSequenceCounter').textContent = `Curio #${index + 1} of ${FACTS_DATABASE.length}`;
      document.getElementById('factCategory').textContent = fact.category;
      document.getElementById('factReadTime').textContent = fact.readTime;
      document.getElementById('factTitle').textContent = fact.title;
      document.getElementById('factHook').textContent = `"${fact.hook}"`;

      // Subheading Labels
      document.getElementById('sec1Title').textContent = fact.sec1Title;
      document.getElementById('sec2Title').textContent = fact.sec2Title;
      document.getElementById('sec3Title').textContent = fact.sec3Title;

      // Body Paragraphs
      document.getElementById('factScale').textContent = fact.scale;
      document.getElementById('factMechanism').textContent = fact.mechanism;
      document.getElementById('factImpact').textContent = fact.impact;
      document.getElementById('factTakeaway').textContent = fact.takeaway;

      // Glow accent
      const glow = document.getElementById('categoryGlow');
      glow.className = `absolute -right-8 -top-8 w-36 h-36 bg-${fact.categoryColor}-500/20 rounded-full blur-2xl pointer-events-none animate-glow`;

      // Render Prompt Chips
      const chipsContainer = document.getElementById('promptChips');
      chipsContainer.innerHTML = '';
      fact.prompts.forEach(promptText => {
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.className = 'px-2.5 py-1 rounded-lg bg-slate-800 hover:bg-slate-700 active:scale-95 text-slate-300 hover:text-white text-[11px] border border-slate-700/60 transition flex items-center gap-1.5 text-left';
        btn.innerHTML = `<i class="fa-solid fa-arrow-turn-down text-[9px] text-blue-400 rotate-90"></i> ${promptText}`;
        btn.onclick = () => askPredefinedPrompt(promptText);
        chipsContainer.appendChild(btn);
      });

      // Reset chat stream
      const chatBox = document.getElementById('chatBox');
      chatBox.innerHTML = `
        <div class="flex gap-2">
          <div class="w-5 h-5 rounded-md bg-blue-600 flex-shrink-0 flex items-center justify-center text-[10px] text-white">
            <i class="fa-solid fa-sparkles"></i>
          </div>
          <div class="text-slate-300 leading-relaxed">
            Curious about the deeper mechanics of <strong>${fact.title.split(':')[0]}</strong>? Select a prompt above or ask a question!
          </div>
        </div>
      `;

      updateBookmarkState();
      document.getElementById('factContainer').scrollTo({ top: 0, behavior: 'smooth' });
    }

    function updateBookmarkState() {
      if (currentFactIndex === -1) return;
      const currentFact = FACTS_DATABASE[currentFactIndex];
      const icon = document.getElementById('bookmarkIcon');
      const isSaved = savedFactIds.has(currentFact.id);

      if (isSaved) {
        icon.className = "fa-solid fa-bookmark text-sm text-yellow-400";
      } else {
        icon.className = "fa-regular fa-bookmark text-sm text-slate-300";
      }

      // Update counter badge
      const counter = document.getElementById('savedCounter');
      if (savedFactIds.size > 0) {
        counter.textContent = savedFactIds.size;
        counter.classList.remove('hidden');
      } else {
        counter.classList.add('hidden');
      }

      try {
        localStorage.setItem('curio_saved_facts', JSON.stringify([...savedFactIds]));
      } catch(e) {}
    }

    function toggleBookmark() {
      if (currentFactIndex === -1) return;
      const currentFact = FACTS_DATABASE[currentFactIndex];
      if (savedFactIds.has(currentFact.id)) {
        savedFactIds.delete(currentFact.id);
        showToast("Removed from Saved Curiosities", "fa-bookmark", "text-slate-400");
      } else {
        savedFactIds.add(currentFact.id);
        showToast("Saved to your personal Curio library!", "fa-bookmark", "text-yellow-400");
      }
      updateBookmarkState();
    }

    function openSavedTray() {
      const tray = document.getElementById('savedTray');
      const list = document.getElementById('savedList');
      list.innerHTML = '';

      if (savedFactIds.size === 0) {
        list.innerHTML = `
          <div class="text-center py-8 text-slate-500 space-y-2">
            <i class="fa-regular fa-bookmark text-3xl opacity-40"></i>
            <p class="text-xs">No saved facts yet.<br>Tap the bookmark icon on any fact to revisit it anytime!</p>
          </div>
        `;
      } else {
        savedFactIds.forEach(id => {
          const fact = FACTS_DATABASE.find(f => f.id === id);
          if (!fact) return;

          const item = document.createElement('div');
          item.className = 'p-3 rounded-xl bg-slate-950/80 border border-slate-800 flex items-center justify-between gap-3 hover:border-slate-700 transition cursor-pointer';
          item.innerHTML = `
            <div class="flex-1 min-w-0" onclick="loadSavedFactById('${fact.id}')">
              <span class="text-[10px] font-semibold text-blue-400 uppercase tracking-wide">${fact.category}</span>
              <h4 class="text-xs font-bold text-white truncate">${fact.title}</h4>
              <p class="text-[11px] text-slate-400 truncate">${fact.hook}</p>
            </div>
            <button onclick="event.stopPropagation(); removeSavedFact('${fact.id}')" class="p-2 text-slate-500 hover:text-red-400 text-xs">
              <i class="fa-solid fa-trash-can"></i>
            </button>
          `;
          list.appendChild(item);
        });
      }

      tray.classList.remove('hidden');
    }

    function closeSavedTray() {
      document.getElementById('savedTray').classList.add('hidden');
    }

    function loadSavedFactById(id) {
      const idx = FACTS_DATABASE.findIndex(f => f.id === id);
      if (idx !== -1) {
        renderFact(idx);
        showReaderScreen();
        closeSavedTray();
      }
    }

    function removeSavedFact(id) {
      savedFactIds.delete(id);
      updateBookmarkState();
      openSavedTray();
    }

    // Text to Speech
    function toggleSpeech() {
      if (!('speechSynthesis' in window)) {
        showToast("Speech synthesis not supported on this browser", "fa-circle-exclamation", "text-red-400");
        return;
      }
      if (isSpeaking) {
        stopSpeech();
      } else {
        startSpeech();
      }
    }

    function startSpeech() {
      if (currentFactIndex === -1) return;
      window.speechSynthesis.cancel();
      const fact = FACTS_DATABASE[currentFactIndex];
      const fullText = `${fact.title}. ${fact.hook}. First: ${fact.scale}. Second: ${fact.mechanism}. Third: ${fact.impact}. Finally: ${fact.takeaway}`;

      speechUtterance = new SpeechSynthesisUtterance(fullText);
      speechUtterance.rate = 0.98;
      speechUtterance.pitch = 1.0;

      speechUtterance.onstart = () => {
        isSpeaking = true;
        document.getElementById('ttsIcon').className = "fa-solid fa-pause text-sm text-blue-400 animate-pulse";
        showToast("Reading aloud...", "fa-volume-high", "text-blue-400");
      };

      speechUtterance.onend = stopSpeech;
      speechUtterance.onerror = stopSpeech;

      window.speechSynthesis.speak(speechUtterance);
    }

    function stopSpeech() {
      if ('speechSynthesis' in window) {
        window.speechSynthesis.cancel();
      }
      isSpeaking = false;
      const ttsIcon = document.getElementById('ttsIcon');
      if (ttsIcon) ttsIcon.className = "fa-solid fa-volume-high text-sm";
    }

    function askPredefinedPrompt(promptText) {
      document.getElementById('chatInput').value = promptText;
      handleChatSubmit(new Event('submit'));
    }

    function handleChatSubmit(e) {
      e.preventDefault();
      const input = document.getElementById('chatInput');
      const question = input.value.trim();
      if (!question || currentFactIndex === -1) return;

      const chatBox = document.getElementById('chatBox');

      const userBubble = document.createElement('div');
      userBubble.className = 'flex justify-end';
      userBubble.innerHTML = `
        <div class="bg-blue-600/90 text-white rounded-xl rounded-tr-none px-3 py-1.5 max-w-[85%] text-slate-100">
          ${escapeHtml(question)}
        </div>
      `;
      chatBox.appendChild(userBubble);
      input.value = '';
      chatBox.scrollTop = chatBox.scrollHeight;

      // Typing loader
      const typingId = 'typing-' + Date.now();
      const typingDiv = document.createElement('div');
      typingDiv.id = typingId;
      typingDiv.className = 'flex gap-2 items-center text-slate-500 italic text-[11px]';
      typingDiv.innerHTML = `
        <div class="w-4 h-4 rounded bg-slate-800 flex items-center justify-center text-[9px] text-blue-400"><i class="fa-solid fa-spinner animate-spin"></i></div>
        <span>Consulting Curio archives...</span>
      `;
      chatBox.appendChild(typingDiv);
      chatBox.scrollTop = chatBox.scrollHeight;

      setTimeout(() => {
        const el = document.getElementById(typingId);
        if (el) el.remove();

        const answer = getFactAnswer(question);
        const botBubble = document.createElement('div');
        botBubble.className = 'flex gap-2';
        botBubble.innerHTML = `
          <div class="w-5 h-5 rounded-md bg-blue-600 flex-shrink-0 flex items-center justify-center text-[10px] text-white">
            <i class="fa-solid fa-sparkles"></i>
          </div>
          <div class="text-slate-300 leading-relaxed bg-slate-900 border border-slate-800 rounded-xl rounded-tl-none p-2.5">
            ${answer}
          </div>
        `;
        chatBox.appendChild(botBubble);
        chatBox.scrollTop = chatBox.scrollHeight;
      }, 500);
    }

    function getFactAnswer(q) {
      const fact = FACTS_DATABASE[currentFactIndex];
      const lower = q.toLowerCase();

      if (fact.knowledgeBase) {
        for (const [key, answer] of Object.entries(fact.knowledgeBase)) {
          if (lower.includes(key)) {
            return answer;
          }
        }
      }

      if (lower.includes("how") || lower.includes("mechanism")) {
        return `Regarding ${fact.title.split(':')[0]}: ${fact.mechanism}`;
      }
      if (lower.includes("why") || lower.includes("significance")) {
        return `The significance lies in: ${fact.impact}`;
      }

      return `Fascinating inquiry! In the context of ${fact.category}: ${fact.takeaway} This makes ${fact.title.split(':')[0]} one of the most distinctive subjects in its field.`;
    }

    function shareFact() {
      if (currentFactIndex === -1) return;
      const fact = FACTS_DATABASE[currentFactIndex];
      const shareData = {
        title: `Curio: ${fact.title}`,
        text: `Did you know? ${fact.hook}`,
        url: window.location.href
      };

      if (navigator.share) {
        navigator.share(shareData).catch(() => {});
      } else {
        const dummy = document.createElement("textarea");
        document.body.appendChild(dummy);
        dummy.value = `${fact.title}\n\n"${fact.hook}"\n\nDeep dive via Curio 3-Min Facts!`;
        dummy.select();
        document.execCommand("copy");
        document.body.removeChild(dummy);
        showToast("Fact copied to clipboard!", "fa-copy", "text-blue-400");
      }
    }

    function showToast(msg, icon = "fa-check", iconColor = "text-emerald-400") {
      const toast = document.getElementById('toast');
      const toastMsg = document.getElementById('toastMsg');
      const toastIcon = document.getElementById('toastIcon');

      toastMsg.textContent = msg;
      toastIcon.className = `fa-solid ${icon} ${iconColor}`;

      toast.classList.remove('opacity-0', 'pointer-events-none');
      toast.classList.add('opacity-100');

      setTimeout(() => {
        toast.classList.remove('opacity-100');
        toast.classList.add('opacity-0', 'pointer-events-none');
      }, 2300);
    }

    function escapeHtml(str) {
      return str.replace(/[&<>'"]/g, 
        tag => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', "'": '&#39;', '"': '&quot;' }[tag] || tag)
      );
    }

